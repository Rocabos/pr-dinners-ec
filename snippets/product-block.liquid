          </svg>

          <span class="t4">{{ block.settings.in_stock_text | escape }}</span>
        </div>
      {%- endif -%}

      {%- if has_free_shipping -%}
        <div class="product-availability-info__item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="13" viewBox="0 0 18 13" fill="none">
