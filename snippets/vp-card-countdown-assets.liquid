{% doc %}
  Scoped Samita countdown CSS for product cards, plus sync script.
  Reads theme settings.card_countdown_code to resolve the timer data-id.
{% enddoc %}
{%- liquid
  assign vp_cd_id = ''
  assign vp_cd_code = settings.card_countdown_code | strip
  if settings.card_countdown_enable and vp_cd_code != blank
    assign vp_cd_parts = vp_cd_code | split: 'data-id="'
    if vp_cd_parts.size > 1
      assign vp_cd_id = vp_cd_parts[1] | split: '"' | first | strip
    endif
    if vp_cd_id == blank
      assign vp_cd_parts = vp_cd_code | split: "data-id='"
      if vp_cd_parts.size > 1
        assign vp_cd_id = vp_cd_parts[1] | split: "'" | first | strip
      endif
    endif
  endif
-%}
{%- if vp_cd_id != blank -%}
  <style data-vp-card-countdown="{{ vp_cd_id | escape }}">
    .card__countdown {
      width: 100%;
      max-width: 100%;
      margin-bottom: 10px;
    }

    /* Theme hides div:empty; keep Samita mount points visible until the app fills them */
    .card__countdown .samita-countdown:empty {
      display: block !important;
    }

    html body product-card div#samita-countdown-{{ vp_cd_id }} .samita_countdown_timer_container {
      width: 100% !important;
      background: #1d1d1f !important;
      border-radius: 12px !important;
      padding: 10px 10px 12px !important;
      box-sizing: border-box !important;
      font-family: inherit !important;
    }

    html body product-card div#samita-countdown-{{ vp_cd_id }} .samita_countdown_timer_container > h2,
    html body product-card div#samita-countdown-{{ vp_cd_id }} .samita_countdown_timer_container > h2 span {
      color: #ffffff !important;
      font-size: 13px !important;
      font-weight: 500 !important;
      line-height: 1.3 !important;
      margin: 0 0 8px !important;
    }

    html body product-card div#samita-countdown-{{ vp_cd_id }} .samita_countdown_timer,
    html body product-card div#samita-countdown-{{ vp_cd_id }} samita-countdown-timer {
      display: block !important;
      width: 100% !important;
    }

    html body product-card div#samita-countdown-{{ vp_cd_id }} .samiCountdown-timer__container {
      display: grid !important;
      grid-template-columns: repeat(4, 1fr) !important;
      gap: 6px !important;
      width: 100% !important;
    }

    html body product-card div#samita-countdown-{{ vp_cd_id }} .samiCountdown-timer__group-container {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 2px !important;
      min-width: 0 !important;
      width: auto !important;
      background: #2c2c2e !important;
      border: 0 !important;
      border-radius: 8px !important;
      padding: 7px 2px !important;
    }

    html body product-card div#samita-countdown-{{ vp_cd_id }} .samiCountdown-timer__group,
    html body product-card div#samita-countdown-{{ vp_cd_id }} .samiCountdown-timer__inner {
      color: #ffffff !important;
      font-size: 20px !important;
      font-weight: 500 !important;
      line-height: 1.1 !important;
      padding: 0 !important;
      width: auto !important;
      justify-content: center !important;
      font-variant-numeric: tabular-nums !important;
    }

    html body product-card div#samita-countdown-{{ vp_cd_id }} span.samiCountdown-timer__group-label {
      color: #a1a1a6 !important;
      font-size: 11px !important;
      white-space: nowrap !important;
      width: auto !important;
    }

    html body product-card div#samita-countdown-{{ vp_cd_id }} .samiCountdown-timer__separator,
    html body product-card div#samita-countdown-{{ vp_cd_id }} .samiCountdown-timer__separator-dot {
      display: none !important;
    }

    @media screen and (max-width: 749px) {
      html body product-card div#samita-countdown-{{ vp_cd_id }} .samita_countdown_timer_container {
        padding: 8px 6px 10px !important;
      }

      html body product-card div#samita-countdown-{{ vp_cd_id }} .samita_countdown_timer_container > h2,
      html body product-card div#samita-countdown-{{ vp_cd_id }} .samita_countdown_timer_container > h2 span {
        font-size: 11px !important;
      }

      html body product-card div#samita-countdown-{{ vp_cd_id }} .samiCountdown-timer__container {
        gap: 4px !important;
      }

      html body product-card div#samita-countdown-{{ vp_cd_id }} .samiCountdown-timer__group-container {
        padding: 6px 1px !important;
        border-radius: 6px !important;
      }

      html body product-card div#samita-countdown-{{ vp_cd_id }} .samiCountdown-timer__group,
      html body product-card div#samita-countdown-{{ vp_cd_id }} .samiCountdown-timer__inner {
        font-size: 16px !important;
      }

      html body product-card div#samita-countdown-{{ vp_cd_id }} span.samiCountdown-timer__group-label {
        font-size: 9px !important;
      }
    }
  </style>
  <script src="{{ 'vp-card-countdown.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
