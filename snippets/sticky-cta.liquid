{{ 'component-sticky-cta.css' | asset_url | stylesheet_tag }}
<script
  src="{{ 'component-sticky-cta.js' | asset_url }}"
  defer="defer"
></script>

<style>
  /* Cuadrícula de 2 filas: arriba el precio tachado; abajo nombre + precio + cuotas */
  #sticky-cta-{{ section.id }}.sticky-cta {
    display: grid !important;
    grid-template-columns: auto auto 1fr auto !important;
    grid-template-rows: auto auto !important;
    column-gap: 22px !important;
    row-gap: 0 !important;
    align-items: center !important;
    max-width: 1200px !important;
    padding-top: 5px !important;
    padding-bottom: 5px !important;
    padding-right: 76px !important; /* espacio para la flecha de subir */
    justify-content: start !important;
    padding-left: 28px !important;
  }

  /* Los contenedores internos se "disuelven" para ubicar sus piezas en la cuadrícula */
  #sticky-cta-{{ section.id }} .sticky-cta__info,
  #sticky-cta-{{ section.id }} .sticky-cta__pricing {
    display: contents !important;
  }

  /* Oculta el texto "NUEVO" */
  #sticky-cta-{{ section.id }} .sticky-cta__badges { display: none !important; }

  /* Fila 2, columna 1: nombre */
  #sticky-cta-{{ section.id }} .sticky-cta__title {
    grid-column: 1 !important;
    grid-row: 2 !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    max-width: 420px !important;
    align-self: center !important;
  }

  /* Fila 1, columna 2: precio tachado, justo encima del precio */
  #sticky-cta-{{ section.id }} .sticky-cta__compare-price {
    grid-column: 2 !important;
    grid-row: 1 !important;
    justify-self: start !important;
    align-self: end !important;
    font-size: 11px !important;
    line-height: 1.1 !important;
  }

  /* Fila 2, columnas 2-3: precio y cuotas en la misma línea que el nombre */
  #sticky-cta-{{ section.id }} .sticky-cta__pricing-row {
    grid-column: 2 / 4 !important;
    grid-row: 2 !important;
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
    min-width: 0 !important;
  }
  #sticky-cta-{{ section.id }} .sticky-cta__price {
    font-size: 19px !important;
    white-space: nowrap !important;
  }

  /* Cantidad y botón a la derecha, ocupando las dos filas */
  #sticky-cta-{{ section.id }} .sticky-cta__actions {
    grid-column: 4 !important;
    grid-row: 1 / span 2 !important;
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
  }
  #sticky-cta-{{ section.id }} .sticky-cta__quantity {
    transform: scale(0.88);
    transform-origin: center;
  }
    #sticky-cta-{{ section.id }} .sticky-cta__button {
    min-width: 220px !important;
    min-height: 42px !important;
    padding-left: 28px !important;
    padding-right: 28px !important;
    font-size: 14px !important;
  }
    #sticky-cta-{{ section.id }} .sticky-cta__actions {
    margin-left: 160px !important;
  }
</style>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign installment_price = current_variant.price | divided_by: 12.0 | round

  assign quantity_min = current_variant.quantity_rule.min | default: 1
  assign quantity_increment = current_variant.quantity_rule.increment | default: 1
  assign quantity_max = current_variant.quantity_rule.max

  assign is_on_sale = false

  if current_variant.compare_at_price > current_variant.price
    assign is_on_sale = true
  endif

  assign is_preorder = false

  if product.template_suffix contains 'preorder'
    assign is_preorder = true
  endif
-%}

<sticky-product-cta
  id="sticky-cta-{{ section.id }}"
  class="
    sticky-cta
    hidden-during-load
    quick-add-hidden
    color-{{ section.settings.cta_color_scheme }}
    gradient
    card--shadow
    border-radius-panel
    {{ section.settings.sticky_panel }}
  "
  data-section-id="{{ section.id }}"
  data-product-form-id="{{ product_form_id }}"
  hidden
>
  <div class="sticky-cta__info">
    <div class="sticky-cta__badges">
      {%- render 'product-badge', product: product, card_product: product, current_variant: current_variant -%}
    </div>

    <strong class="sticky-cta__title t3">
      {{ product.title }}
    </strong>
  </div>

  <div class="sticky-cta__pricing">
    <s
      class="sticky-cta__compare-price"
      data-sticky-compare-price
      {% unless is_on_sale %}
        hidden
      {% endunless %}
    >
      {{ current_variant.compare_at_price | money }}
    </s>

    <div class="sticky-cta__pricing-row">
      <strong
        class="sticky-cta__price"
        data-sticky-price
      >
        {{ current_variant.price | money }}
      </strong>

      {%- capture info_cuotas -%}
        {%- render 'product-installment-info', product: product -%}
      {%- endcapture -%}

      {%- liquid
        assign limpio = info_cuotas | strip_html | strip_newlines | strip
        assign palabras = limpio | split: ' '
        assign num_cuotas = ''
        assign valor_cuota = ''

        for palabra in palabras
          assign i = forloop.index0 | minus: 1
          if palabra == 'cuotas' and num_cuotas == '' and i >= 0
            assign num_cuotas = palabras[i]
          endif
          if palabra contains '$' and valor_cuota == '' and i >= 0
            if palabras[i] == 'US'
              assign valor_cuota = 'US ' | append: palabra
            else
              assign valor_cuota = palabra
            endif
          endif
        endfor
      -%}

      {%- if num_cuotas != '' and valor_cuota != '' -%}
        {%- assign valor_sin_us = valor_cuota | remove: 'US ' -%}
        <span class="sticky-cta__installments" style="font-size:14px; line-height:1.3; white-space:nowrap; font-weight:400; color:rgba(0,0,0,.75);">
          Hasta {{ num_cuotas }} cuotas de {{ valor_sin_us }} a 0% de interés Con tu Diners
        </span>
      {%- endif -%}
    </div>
  </div>

  <div class="sticky-cta__actions">
    <div class="sticky-cta__quantity">
      <input
        class="sticky-cta__quantity-input"
        type="number"
        value="{{ quantity_min }}"
        min="{{ quantity_min }}"
        step="{{ quantity_increment }}"
        {% if quantity_max != blank %}
          max="{{ quantity_max }}"
        {% endif %}
        aria-label="{{ 'products.product.quantity.label' | t }}"
        data-sticky-quantity
      >

      <div class="sticky-cta__quantity-buttons">
        <button
          type="button"
          aria-label="Aumentar cantidad"
          data-sticky-quantity-plus
        >
          <svg viewBox="0 0 10 6" aria-hidden="true">
            <path
              d="M1 5 5 1l4 4"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <button
          type="button"
          aria-label="Disminuir cantidad"
          data-sticky-quantity-minus
        >
          <svg viewBox="0 0 10 6" aria-hidden="true">
            <path
              d="m1 1 4 4 4-4"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>
    </div>

    <button
      type="{% if product_form_id != blank %}submit{% else %}button{% endif %}"
      {% if product_form_id != blank %}
        form="{{ product_form_id }}"
        name="add"
      {% else %}
        data-anchor="#MainProduct-{{ section.id }}"
      {% endif %}
      class="
        sticky-cta__submit-button
        sticky-cta__button
        button
        button--primary
        button--small
        button--full-width
        {% if buy_buttons_block.settings.button_text_font_weight == 'bold' %}
          font-bold
        {% endif %}
        {% if buy_buttons_block.settings.icon != blank %}
          button-with-icon
        {% endif %}
        {% if buy_buttons_block.settings.icon != blank
          and buy_buttons_block.settings.icon_position == 'right'
        %}
          button--full-width-icon-right
        {% endif %}
      "
      data-sticky-submit
      {% if current_variant.available == false or quantity_rule_soldout or current_variant == null %}
        disabled
      {% endif %}
      style="
        --font-button-case:
          {{ buy_buttons_block.settings.button_text_transform }};
        --font-button-font-weight:
          {{ buy_buttons_block.settings.button_text_font_weight }};
      "
    >
      {%- if buy_buttons_block.settings.icon != blank and buy_buttons_block.settings.icon_position == 'left' -%}
        {%- render 'icon', icon: buy_buttons_block.settings.icon, class: 'relative' -%}
      {%- endif -%}

      <span data-sticky-button-text>
        {%- if current_variant == null -%}
          {{ 'products.product.unavailable' | t }}
        {%- elsif current_variant.available == false or quantity_rule_soldout -%}
          {{ 'products.product.sold_out' | t }}
        {%- elsif is_preorder -%}
          {{ 'products.product.preorder' | t }}
        {%- else -%}
          {{ 'products.product.add_to_cart' | t }}
        {%- endif -%}
      </span>

      {%- if buy_buttons_block.settings.icon != blank and buy_buttons_block.settings.icon_position == 'right' -%}
        {%- render 'icon', icon: buy_buttons_block.settings.icon, class: 'relative' -%}
      {%- endif -%}

      {%- render 'loading-spinner' -%}
    </button>
  </div>

  <script type="application/json" data-sticky-variant-data>
    {
      "texts": {
        "addToCart": {{ 'products.product.add_to_cart' | t | json }},
        "soldOut": {{ 'products.product.sold_out' | t | json }},
        "unavailable": {{ 'products.product.unavailable' | t | json }},
        "preorder": {{ 'products.product.preorder' | t | json }}
      },
      "isPreorder": {{ is_preorder | json }},
      "variants": [
        {%- for variant in product.variants -%}
          {%- liquid
            assign variant_installment = variant.price | divided_by: 12.0 | round
            assign variant_min = variant.quantity_rule.min | default: 1
            assign variant_increment = variant.quantity_rule.increment | default: 1
          -%}

          {
            "id": {{ variant.id | json }},
            "available": {{ variant.available | json }},
            "priceValue": {{ variant.price | json }},
            "price": {{ variant.price | money | json }},
            "compareAtPriceValue": {{ variant.compare_at_price | default: 0 | json }},
            "compareAtPrice": {% if variant.compare_at_price != blank %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
            "installmentPrice": {{ variant_installment | money | json }},
            "minimum": {{ variant_min | json }},
            "increment": {{ variant_increment | json }},
            "maximum": {% if variant.quantity_rule.max != blank %}{{ variant.quantity_rule.max | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</sticky-product-cta>