{%- comment -%}theme-check-disable SchemaJsonFormat{%- endcomment -%}
{%- render 'multicolumn', is_social_video_reel: true -%}

{% schema %}
{
  "name": "Social video reel",
  "class": "section section-multicolumn section-social-video-reel",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "select",
      "id": "video_ratio",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        },
        {
          "value": "portrait_medium",
          "label": "Portrait (3:4)"
        },
        {
          "value": "portrait_tall",
          "label": "Portrait (2:3)"
        },
        {
          "value": "portrait_video",
          "label": "Portrait (9:16)"
        }
      ],
      "default": "portrait_video",
      "label": "Aspect ratio"
    },
    {
      "type": "select",
      "id": "autoplay",
      "options": [
        {
          "value": "first",
          "label": "First video"
        },
        {
          "value": "all",
          "label": "All videos"
        }
      ],
      "default": "first",
      "info": "Video will have no sound and may not always autoplay on mobile. This is determined by the device. [Read more](https://benchmarkthemes.com/help-center/ignite/guides/video-faq/)",
      "label": "Autoplay"
    },
    {
      "type": "select",
      "id": "on_click_action",
      "options": [
        {
          "value": "",
          "label": "Do nothing"
        },
        {
          "value": "link",
          "label": "Go to page/product"
        },
        {
          "value": "modal",
          "label": "Open popup"
        }
      ],
      "default": "modal",
      "label": "On click"
    },
    {
      "type": "paragraph",
      "visible_if": "{{ section.settings.on_click_action == 'link' }}",
      "content": "The page can be set within the settings for each individual social video block."
    },
    {
      "type": "checkbox",
      "id": "show_unmute_button",
      "label": "Show unmute button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "clamp_product_titles",
      "label": "Restrict product titles to two lines",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_caption_mobile",
      "default": false,
