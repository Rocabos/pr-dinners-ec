{{ 'vp-landing-complementa.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign card_scheme = section.settings.card_color_scheme
  assign show_title = section.settings.show_title
  assign show_price = section.settings.show_price
  assign button_label = section.settings.button_label
  if button_label == blank
    assign button_label = 'Comprar ahora'
  endif
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

<section
  id="vp-landing-complementa-{{ section.id }}"
  class="vp-landing-complementa color-{{ scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="vp-landing-complementa__inner page-width">
    {%- if section.settings.heading != blank -%}
      <header class="vp-landing-complementa__header">
        <h2 class="vp-landing-complementa__heading">
          {{ section.settings.heading | escape }}
        </h2>
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="vp-landing-complementa__grid" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'product_card' -%}
            {%- liquid
              assign card_product = block.settings.product
              assign card_title = ''
              assign card_price = nil
              assign card_url = ''
              assign card_image = block.settings.image
              assign card_desc_html = block.settings.description
              assign card_desc_plain = ''

              if card_product != blank
                assign card_title = card_product.title
                assign card_price = card_product.price
                assign card_url = card_product.url
                if card_image == blank and card_product.featured_media != blank
                  assign card_image = card_product.featured_media
                endif
                if card_desc_html == blank and card_product.description != blank
                  assign card_desc_plain = card_product.description | strip_html | truncate: 140
                endif
              endif

              assign card_alt = card_title | escape
              if card_alt == blank
                assign card_alt = section.settings.heading | escape
              endif
              if card_image != blank and card_image.alt != blank
                assign card_alt = card_image.alt | escape
              endif

              assign show_card = false
              if card_product != blank or card_image != blank or card_desc_html != blank or request.design_mode
                assign show_card = true
              endif
            -%}
            {%- if show_card -%}
              <li
                class="vp-landing-complementa__card color-{{ card_scheme }} gradient{% if card_product == blank %} vp-landing-complementa__card--empty{% endif %}"
                {{ block.shopify_attributes }}
              >
                <div class="vp-landing-complementa__media">
                  {%- if card_image != blank -%}
                    {{
                      card_image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        widths: '320, 480, 640, 800',
                        sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw',
                        alt: card_alt,
                        class: 'vp-landing-complementa__img'
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'vp-landing-complementa__img placeholder' }}
                  {%- endif -%}
                </div>

                <div class="vp-landing-complementa__body">
                  <div class="vp-landing-complementa__copy">
                    {%- if show_title and card_title != blank -%}
                      <h3 class="vp-landing-complementa__title">{{ card_title | escape }}</h3>
                    {%- endif -%}

                    {%- if card_desc_html != blank -%}
                      <div class="vp-landing-complementa__desc rte">{{ card_desc_html }}</div>
                    {%- elsif card_desc_plain != blank -%}
                      <p class="vp-landing-complementa__desc">{{ card_desc_plain | escape }}</p>
                    {%- elsif card_product == blank and request.design_mode -%}
                      <p class="vp-landing-complementa__desc">Selecciona un producto en este bloque.</p>
                    {%- endif -%}

                    {%- if show_price and card_price != nil -%}
                      <p class="vp-landing-complementa__price">{{ card_price | money }}</p>
                    {%- endif -%}
                  </div>

                  {%- if card_url != blank -%}
                    <a
                      class="vp-landing-complementa__button button button--secondary"
                      href="{{ card_url }}"
                    >
                      {{ button_label | escape }}
                    </a>
                  {%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Landing Complementa",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titulo de seccion",
      "default": "Complementa tu nuevo iPhone."
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Mostrar titulo del producto",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Mostrar precio",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del boton",
      "default": "Comprar ahora"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color (seccion)",
      "default": "scheme-14"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Esquema de color (tarjeta)",
      "default": "scheme-16"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding superior",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Producto",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Producto"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen (opcional)",
          "info": "Si esta vacia, se usa la imagen del producto."
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Descripcion (opcional)",
          "info": "Si esta vacia, se usa un extracto de la descripcion del producto."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Landing Complementa",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}
