{%- comment -%}theme-check-disable SchemaJsonFormat{%- endcomment -%}
{{ 'vp-announcement-bar.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign announcements_size = 0
  assign announcements_to_show = ""
  assign announcements_first_color = ""

  for block in section.blocks
    assign show_this_announcement = false
    assign has_announcement_content = false
    assign vp_ab_check_text = block.settings.text | strip_html | strip
    assign vp_ab_check_text_after = block.settings.text_after | strip_html | strip
    assign vp_ab_check_mobile_text = block.settings.mobile_text | strip_html | strip
    assign vp_ab_check_mobile_text_after = block.settings.mobile_text_after | strip_html | strip
    if vp_ab_check_text != blank or vp_ab_check_text_after != blank or block.settings.image != blank or vp_ab_check_mobile_text != blank or vp_ab_check_mobile_text_after != blank
      assign has_announcement_content = true
    endif

    if has_announcement_content
      unless block.settings.announcement_pages == blank
        assign match = block.settings.announcement_pages.links | where: 'url', request.path
        if match != blank
          assign show_this_announcement = true
        endif
      endunless

      if block.settings.announcement_pages == blank or show_this_announcement
        if announcements_first_color == ""
          assign announcements_first_color = block.settings.color_scheme
        endif
        assign announcements_size = announcements_size | plus: 1
        assign announcements_to_show = announcements_to_show | append: "," | append: forloop.index | append: ","
      endif
    endif
  endfor

  if section.settings.enable_country_selector and localization.available_countries.size > 1
    assign show_country_picker = true
  endif

  if section.settings.enable_language_selector and localization.available_languages.size > 1
    assign show_language_picker = true
  endif

  if shop.customer_accounts_enabled and section.settings.enable_accounts
    assign show_accounts = true
  endif

  assign centralize_announcement = true
  if section.settings.link_1_label != blank or section.settings.link_2_label != blank or show_country_picker or show_language_picker or show_accounts
    assign centralize_announcement = false
  endif
-%}

{%- if announcements_size > 0 -%}
<link rel="stylesheet" href="{{ 'component-slideshow.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">

<div
  class="utility-bar color-{{ announcements_first_color }} gradient {{ section.settings.text_size }}{% if section.settings.show_line_separator and announcements_size > 0 %} utility-bar--bottom-border{% endif %}{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header-localization{% endif %}"
  style="--announcement-padding: {{ section.settings.text_padding }}rem;"
  {{ block.shopify_attributes }}
>
  <div class="page-width flex">
    <slideshow-component
      class="announcement-bar md:self-center"
      role="region"
      aria-roledescription="{{ 'sections.announcements.carousel' | t }}"
      aria-label="{{ 'sections.announcements.announcement_bar' | t }}"
    >
      <div class="announcement-bar-slider slider-buttons w-full">
        <div
          class="grid grid--1-col slider slider--everywhere"
          id="Slider-{{ section.id }}"
          aria-live="polite"
          aria-atomic="true"
          data-autoplay="{% if announcements_size > 1 %}true{% else %}false{% endif %}"
          data-speed="{{ section.settings.change_slides_speed }}"
          style="flex-wrap: inherit;"
        >
          {%- for block in section.blocks -%}
            {%- assign this_index = "," | append: forloop.index | append: "," -%}
            {%- if announcements_to_show contains this_index -%}
              <div
                class="slideshow__slide announcement-slideshow__slide slider__slide grid__item grid--1-col{% unless forloop.first %} hidden-during-load{% endunless %}"
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                {{ block.shopify_attributes }}
                data-color-scheme="color-{{ block.settings.color_scheme }}"
                role="group"
                aria-roledescription="{{ 'sections.announcements.announcement' | t }}"
                aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                tabindex="-1"
              >
                <div
                  class="announcement-bar__announcement{% unless centralize_announcement %} announcement-bar__announcement-left{% endunless %}"
                  role="region"
                  aria-label="{{ 'sections.header.announcement' | t }}"
                  {{ block.shopify_attributes }}
                >
                  {%- liquid
                    assign vp_ab_text = block.settings.text | strip_html | strip
                    assign vp_ab_mobile_text = block.settings.mobile_text | strip_html | strip
                    assign vp_ab_text_after = block.settings.text_after | strip_html | strip
                    assign vp_ab_mobile_text_after = block.settings.mobile_text_after | strip_html | strip
                  -%}
                  {%- if vp_ab_text != blank or vp_ab_text_after != blank or block.settings.image != blank or vp_ab_mobile_text != blank or vp_ab_mobile_text_after != blank -%}
                    {%- liquid
                      assign announcement_image_height = block.settings.image_height | default: 18
                      assign announcement_image_height_mobile = block.settings.image_height_mobile | default: announcement_image_height
                      if block.settings.image != blank and block.settings.image.aspect_ratio != blank
                        assign announcement_image_width = announcement_image_height | times: block.settings.image.aspect_ratio | round
                        assign announcement_image_width_mobile = announcement_image_height_mobile | times: block.settings.image.aspect_ratio | round
                      else
                        assign announcement_image_width = announcement_image_height | times: 4
                        assign announcement_image_width_mobile = announcement_image_height_mobile | times: 4
                      endif
                      assign announcement_image_alt = block.settings.image_alt | default: block.settings.image.alt | escape
                      assign announcement_image_sizes = '(max-width: 749px) ' | append: announcement_image_width_mobile | append: 'px, ' | append: announcement_image_width | append: 'px'
                      assign text_before_size = block.settings.text_before_size | default: 14
                      assign text_before_size_mobile = block.settings.text_before_size_mobile | default: text_before_size
                      assign text_after_size = block.settings.text_after_size | default: 12
                      assign text_after_size_mobile = block.settings.text_after_size_mobile | default: text_after_size
                    -%}
                    <div
                      class="announcement-bar__message vp-announcement-bar__message xs:text-center rte"
                      style="
                        --vp-ab-image-height: {{ announcement_image_height }}px;
                        --vp-ab-image-width: {{ announcement_image_width }}px;
                        --vp-ab-image-height-mobile: {{ announcement_image_height_mobile }}px;
                        --vp-ab-image-width-mobile: {{ announcement_image_width_mobile }}px;
                        --vp-ab-text-before-size: {{ text_before_size }}px;
                        --vp-ab-text-before-size-mobile: {{ text_before_size_mobile }}px;
                        --vp-ab-text-after-size: {{ text_after_size }}px;
                        --vp-ab-text-after-size-mobile: {{ text_after_size_mobile }}px;
                      "
                    >
                      <div class="vp-announcement-bar__row">
                        {%- if vp_ab_text != blank or vp_ab_mobile_text != blank -%}
                          <div class="vp-announcement-bar__text vp-announcement-bar__text--before">
                            {% if vp_ab_mobile_text != blank %}
                              <div class="hidden-xs">{{ block.settings.text }}</div>
                              <div class="visible-xs">{{ block.settings.mobile_text }}</div>
                            {% elsif vp_ab_text != blank %}
                              {{ block.settings.text }}
                            {% endif %}
                          </div>
                        {%- endif -%}

                        {%- if block.settings.image != blank -%}
                          <span class="vp-announcement-bar__image-slot">
                            {{
                              block.settings.image
                              | image_url: width: 400
                              | image_tag:
                                class: 'vp-announcement-bar__image',
                                widths: '80, 120, 160, 240, 320, 400',
                                sizes: announcement_image_sizes,
                                width: announcement_image_width,
                                height: announcement_image_height,
                                alt: announcement_image_alt,
                                loading: 'lazy'
                            }}
                          </span>
                        {%- endif -%}

                        {%- if vp_ab_text_after != blank or vp_ab_mobile_text_after != blank -%}
                          <div class="vp-announcement-bar__text vp-announcement-bar__text--after">
                            {% if vp_ab_mobile_text_after != blank %}
                              <div class="hidden-xs">{{ block.settings.text_after }}</div>
                              <div class="visible-xs">{{ block.settings.mobile_text_after }}</div>
                            {% elsif vp_ab_text_after != blank %}
                              {{ block.settings.text_after }}
                            {% endif %}
                          </div>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </slideshow-component>

    {%- if request.design_mode -%}
      <style>
        /* theme editor power preview fix */
        .announcement-bar-slider .slider__slide[aria-hidden='true'] {
          visibility: hidden;
        }
      </style>
    {%- endif -%}

    <div class="announcement__icons flex items-center gap-2" role="navigation" id="announcement_navigation">
      {%- if section.settings.link_1_label != blank -%}
        <a href="{{ section.settings.link_1_url }}" class="{{ section.settings.text_size }} link un-underlined-link flex items-center gap-05 whitespace-nowrap hidden-xs">
          {%- if section.settings.link_1_icon != blank -%}
            {%- render 'icon', icon: section.settings.link_1_icon, size: 18 -%}
          {%- endif -%}
          {{ section.settings.link_1_label }}
        </a>
      {%- endif -%}

      {%- if section.settings.link_2_label != blank -%}
        <a href="{{ section.settings.link_2_url }}" class="{{ section.settings.text_size }} link un-underlined-link flex items-center gap-05 whitespace-nowrap hidden-xs">
          {%- if section.settings.link_2_icon != blank -%}
            {%- render 'icon', icon: section.settings.link_2_icon, size: 18 -%}
          {%- endif -%}
          {{ section.settings.link_2_label }}
        </a>
      {%- endif -%}

      {%- if show_accounts -%}
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="{{ section.settings.text_size }} link un-underlined-link flex items-center gap-05 whitespace-nowrap hidden-xs">
          {%- render 'icon', icon: 'silhouette_circle', size: 18 -%}
          {%- liquid
            if customer
              echo 'customer.account_fallback' | t
            else
              echo 'customer.log_in' | t
            endif
          -%}
        </a>
      {%- endif -%}

      <div class="localization-wrapper small-hide medium-hide no-js-hidden{% if section.settings.text_padding <= 1 %} localization-wrapper--h-full{% endif %}">
        {%- if show_country_picker or show_language_picker -%}
          <localization-form data-prevent-hide>
            {%- form 'localization', id: 'AnnouncmentLocalizationForm', class: 'localization-form' -%}
              <div>
                {%- render 'localization',
                    localPosition: 'AnnouncementLocalization',
                    show_country_picker: show_country_picker,
                    show_language_picker: show_language_picker,
                    show_country_name: false,
                    show_country_filter: section.settings.show_country_filter,
                    always_show_currency: true,
                    disclosure_class: 'disclosure--has-arrow',
                    font_size_class: section.settings.text_size,
                    abbreviate: false
                -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{%- endif -%}

