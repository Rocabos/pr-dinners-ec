{{ 'vp-landing-scene-plata.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scene_image = section.settings.image
  assign scene_alt = section.settings.image_alt | default: section.settings.heading | escape
-%}

<section
  id="vp-landing-plata-{{ section.id }}"
  class="vp-landing-plata"
>
  {%- if scene_image != blank -%}
    <div class="vp-landing-plata__media">
      {{
        scene_image
        | image_url: width: 2400
        | image_tag:
          class: 'vp-landing-plata__img',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: 'lazy',
          alt: scene_alt
      }}
    </div>
  {%- elsif request.design_mode -%}
    <div class="vp-landing-plata__media">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'vp-landing-plata__img placeholder' }}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul class="vp-landing-plata__chips" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'chip' -%}
          {%- liquid
            assign chip_title = block.settings.title
            assign chip_text = block.settings.text
            assign chip_icon = block.settings.icon
            assign chip_icon_asset = block.settings.icon_asset | strip
          -%}
          {%- if chip_title != blank or chip_text != blank or chip_icon != blank or chip_icon_asset != blank -%}
            <li class="vp-landing-plata__chip" {{ block.shopify_attributes }}>
              {%- if chip_icon != blank or chip_icon_asset != blank -%}
                <span class="vp-landing-plata__chip-icon" aria-hidden="true">
                  {%- if chip_icon != blank -%}
                    {{
                      chip_icon
                      | image_url: width: 88
                      | image_tag:
                        width: 22,
                        height: 22,
                        loading: 'lazy',
                        alt: ''
                    }}
                  {%- elsif chip_icon_asset != blank -%}
                    <img
                      src="{{ chip_icon_asset | asset_url }}"
                      width="22"
                      height="22"
                      alt=""
                      loading="lazy"
                    >
                  {%- endif -%}
                </span>
              {%- endif -%}

              <div class="vp-landing-plata__chip-copy">
                {%- if chip_title != blank -%}
                  <p class="vp-landing-plata__chip-title">{{ chip_title | escape }}</p>
                {%- endif -%}
                {%- if chip_text != blank -%}
                  <p class="vp-landing-plata__chip-text">{{ chip_text | escape }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "VP Escena Plata",
  "tag": "section",
  "class": "section-vp-landing-plata",
  "max_blocks": 8,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de escena"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo",
      "default": "iPhone 18 Pro en Plata"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titulo (referencia)",
      "default": "Pro por dentro. Brillante por fuera.",
      "info": "Solo para alt/SEO si la imagen ya incluye el texto."
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Chip",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icono (imagen)"
        },
        {
          "type": "text",
          "id": "icon_asset",
          "label": "Icono (archivo en assets)",
          "info": "Ej: vp-landing-chip-camera.svg. Se usa si no hay imagen."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titulo",
          "default": "Cámara Fusion de 48 MP"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Subtitulo",
          "default": "Con apertura variable"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VP Escena Plata",
      "blocks": [
        {
          "type": "chip",
          "settings": {
            "icon_asset": "vp-landing-chip-camera.svg",
            "title": "Cámara Fusion de 48 MP",
            "text": "Con apertura variable"
          }
        },
        {
          "type": "chip",
          "settings": {
            "icon_asset": "vp-landing-chip-shield.svg",
            "title": "Ceramic Shield",
            "text": "Delante y atrás"
          }
        },
        {
          "type": "chip",
          "settings": {
            "icon_asset": "vp-landing-chip-island.svg",
            "title": "Dynamic Island",
            "text": "Más pequeña, más pantalla"
          }
        },
        {
          "type": "chip",
          "settings": {
            "icon_asset": "vp-landing-chip-plata.svg",
            "title": "Acabado en Plata",
            "text": "Diseñado para durar"
          }
        }
      ]
    }
  ]
}
{% endschema %}
