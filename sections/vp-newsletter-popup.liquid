{%- comment -%}theme-check-disable ImgLazyLoading{%- endcomment -%}
{{ 'component-popup.css' | asset_url | stylesheet_tag }}
{{ 'vp-newsletter-popup.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign form_id = 'vp-newsletter-' | append: section.id
  assign show_immediately = false

  assign posted_successfully = false
  form 'customer', id: form_id
    if form.posted_successfully?
      assign posted_successfully = true
      assign show_immediately = true
    endif
  endform

  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif

  assign has_mobile_image = false
  if section.settings.mobile_image != blank
    assign has_mobile_image = true
  endif

  assign aria_label = section.settings.heading | strip_html | escape
  if aria_label == blank
    assign aria_label = 'accessibility.popup' | t
  endif

  assign email_placeholder = section.settings.email_placeholder
  if email_placeholder == blank
    assign email_placeholder = 'newsletter.label' | t
  endif

  assign button_label = section.settings.button_label
  if button_label == blank
    assign button_label = 'newsletter.button_label' | t
  endif

  assign popup_width = section.settings.popup_width | default: 880
  assign popup_height = section.settings.popup_height | default: 440
  assign popup_width_mobile = section.settings.popup_width_mobile | default: 343
  assign popup_height_mobile = section.settings.popup_height_mobile | default: 407
  assign popup_offset_y_mobile = section.settings.popup_offset_y_mobile | default: 0
-%}

<custom-popup
  id="PopupModal-{{ section.id }}"
  class="
    popup-modal vp-newsletter-popup p-2 flex
    {{ section.settings.mobile_content_position }}
    {{ section.settings.desktop_content_position }}
    {% unless has_image %} vp-newsletter-popup--no-image{% endunless %}
    {% if section.settings.hide_image_mobile %} vp-newsletter-popup--hide-image-mobile{% endif %}
  "
  data-trigger="{{ section.settings.show_trigger }}"
  data-delay-seconds="{% if show_immediately %}0{% else %}{{ section.settings.show_delay }}{% endif %}"
  data-visibility="{{ section.settings.visibility }}"
  data-popup-trigger-id="{{ section.settings.popup_id | escape }}"
  data-popup-id="{{ section.id }}"
  data-mode="{{ section.settings.mode }}"
  {% if section.settings.show_at_specific_time_of_day and request.design_mode == false %}
    data-time-of-day-to-show="{% if section.settings.show_time_morning %}morning,{% endif %}{% if section.settings.show_time_afternoon %}afternoon,{% endif %}{% if section.settings.show_time_evening %}evening,{% endif %}{% if section.settings.show_time_night %}night{% endif %}"
  {% endif %}
  style="visibility: hidden;"
>
  <div
    role="dialog"
    aria-label="{{ aria_label }}"
    aria-modal="true"
    tabindex="-1"
    class="popup-modal__content vp-newsletter-popup__content custom-scrollbar"
    style="
      --vp-np-panel-bg: {{ section.settings.panel_background }};
      --vp-np-text: {{ section.settings.text_color }};
      --vp-np-input-bg: {{ section.settings.input_background }};
      --vp-np-button-bg: {{ section.settings.button_background }};
      --vp-np-button-text: {{ section.settings.button_text_color }};
      --vp-np-link: {{ section.settings.link_color }};
      --vp-np-close: {{ section.settings.close_color }};
      --vp-np-corner-radius: {{ section.settings.corner_radius }}px;
      --vp-np-input-radius: {{ section.settings.input_radius }}px;
      --vp-np-button-radius: {{ section.settings.button_radius }}px;
      --vp-np-d-width: {{ popup_width }}px;
      --vp-np-d-height: {{ popup_height }}px;
      --vp-np-d-scale-x: {{ popup_width | times: 1.0 | divided_by: 880.0 }};
      --vp-np-d-scale-y: {{ popup_height | times: 1.0 | divided_by: 440.0 }};
      --vp-np-m-width: {{ popup_width_mobile }}px;
      --vp-np-m-height: {{ popup_height_mobile }}px;
      --vp-np-m-scale-x: {{ popup_width_mobile | times: 1.0 | divided_by: 343.0 }};
      --vp-np-m-scale-y: {{ popup_height_mobile | times: 1.0 | divided_by: 407.0 }};
      --vp-np-m-offset-y: {{ popup_offset_y_mobile }}px;
    "
  >
    {% if section.settings.show_close %}
      <button
        id="ModalClose-{{ section.id }}"
        type="button"
        class="popup-modal__toggle"
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {% render 'icon-close' %}
      </button>
    {% endif %}

    <div
      class="
        vp-newsletter-popup__layout
        {% if section.settings.image_position == 'right' %} vp-newsletter-popup__layout--image-right{% endif %}
      "
    >
      {%- if has_image -%}
        <div class="vp-newsletter-popup__media">
          {%- liquid
            assign desktop_alt = section.settings.image.alt | default: section.settings.heading | strip_html | escape
            if has_mobile_image
              assign mobile_alt = section.settings.mobile_image.alt | default: desktop_alt | escape
            endif
          -%}
          {%- if has_mobile_image -%}
            {{
              section.settings.mobile_image
              | image_url: width: 686
              | image_tag:
                class: 'vp-newsletter-popup__media-img large-up-hide',
                loading: 'lazy',
                widths: '343, 686',
                sizes: '(min-width: 750px) 0px, 343px',
                alt: mobile_alt
            }}
            {{
              section.settings.image
              | image_url: width: 660
              | image_tag:
                class: 'vp-newsletter-popup__media-img small-hide',
                loading: 'lazy',
                widths: '330, 660',
                sizes: '330px',
                alt: desktop_alt
            }}
          {%- else -%}
            {{
              section.settings.image
              | image_url: width: 880
              | image_tag:
                class: 'vp-newsletter-popup__media-img',
                loading: 'lazy',
                widths: '343, 660, 686, 880',
                sizes: '(min-width: 750px) 330px, 343px',
                alt: desktop_alt
            }}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="vp-newsletter-popup__panel text-{{ section.settings.content_alignment }}">
        <div class="vp-newsletter-popup__panel-main">
        {%- if section.settings.heading != blank -%}
          <h2 class="vp-newsletter-popup__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="vp-newsletter-popup__text rte">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- liquid
          assign success_message = section.settings.success_message
          if success_message == blank
            assign success_message = 'Gracias por escribirte'
          endif
        -%}
        <vp-newsletter-form
          class="vp-newsletter-popup__form-host{% if posted_successfully %} is-success{% endif %}"
          data-success-message="{{ success_message | escape }}"
          data-inline-success="{% if section.settings.show_success_in_popup %}true{% else %}false{% endif %}"
        >
          {%- form 'customer', id: form_id, return_to: section.settings.return_to -%}
            {%- if section.settings.show_success_in_popup -%}
              <p
                class="vp-newsletter-popup__message vp-newsletter-popup__message--success"
                id="Newsletter-success--{{ section.id }}"
                tabindex="-1"
              >
                {{ success_message }}
              </p>
            {%- endif -%}

            <div class="vp-newsletter-popup__form">
              <input
                type="hidden"
                name="contact[tags]"
                value="{{ section.settings.customer_tags | default: 'newsletter' | escape }}"
              >

              <label class="visually-hidden" for="NewsletterForm--{{ section.id }}">
                {{ email_placeholder | escape }}
              </label>
              <input
                id="NewsletterForm--{{ section.id }}"
                class="vp-newsletter-popup__input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ email_placeholder | escape }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                aria-required="true"
                required
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="Newsletter-error--{{ section.id }}"
                {% endif %}
              >

              {%- if form.errors -%}
                <small class="vp-newsletter-popup__message" id="Newsletter-error--{{ section.id }}">
                  {{- form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email -}}
                </small>
              {%- endif -%}

              <button
                type="submit"
                class="vp-newsletter-popup__submit"
                name="commit"
                id="Subscribe-{{ section.id }}"
              >
                {{ button_label | escape }}
              </button>
            </div>
          {%- endform -%}
        </vp-newsletter-form>

        {%- if section.settings.privacy_text != blank or section.settings.privacy_link_label != blank -%}
          <p class="vp-newsletter-popup__privacy">
            {%- if section.settings.privacy_text != blank -%}
              {{ section.settings.privacy_text | escape }}
            {%- endif -%}
            {%- if section.settings.privacy_link_label != blank -%}
              {%- if section.settings.privacy_text != blank %} {% endif -%}
              <a
                class="vp-newsletter-popup__privacy-link"
                href="{{ section.settings.privacy_link_url | default: routes.root_url }}"
                {% if section.settings.privacy_link_new_tab %}
                  target="_blank"
                  rel="noopener"
                {% endif %}
              >
                {{- section.settings.privacy_link_label | escape -}}
              </a>
            {%- endif -%}
          </p>
        {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</custom-popup>

{% javascript %}
if (!customElements.get('vp-newsletter-form')) {
  class VPNewsletterForm extends HTMLElement {
    connectedCallback() {
      this.form = this.querySelector('form');
      if (!this.form || this.dataset.inlineSuccess !== 'true') return;

      this.fields = this.querySelector('.vp-newsletter-popup__form');
      this.success = this.querySelector('.vp-newsletter-popup__message--success');
      this.submitButton = this.form.querySelector('[type="submit"]');
      this.onSubmit = this.handleSubmit.bind(this);
      this.form.addEventListener('submit', this.onSubmit);
    }

    disconnectedCallback() {
      if (!this.form || !this.onSubmit) return;
      this.form.removeEventListener('submit', this.onSubmit);
    }

    async handleSubmit(event) {
      event.preventDefault();
      if (!this.form.checkValidity()) {
        this.form.reportValidity();
        return;
      }

      if (this.submitButton) this.submitButton.disabled = true;

      try {
        const response = await fetch(this.form.action || window.location.pathname, {
          method: 'POST',
          body: new FormData(this.form),
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });

        if (!response.ok) throw new Error('request-failed');
        this.showSuccess();
      } catch (error) {
        if (this.submitButton) this.submitButton.disabled = false;
        this.form.submit();
      }
    }

    showSuccess() {
      this.classList.add('is-success');
      if (this.fields) this.fields.hidden = true;
      if (this.success) {
        if (!this.success.textContent.trim()) {
          this.success.textContent = this.dataset.successMessage || '';
        }
        this.success.hidden = false;
        this.success.focus();
      }
    }
  }

  customElements.define('vp-newsletter-form', VPNewsletterForm);
}
{% endjavascript %}

{% stylesheet %}
.popup-modal.vp-newsletter-popup .vp-newsletter-popup__content {
  width: min(var(--vp-np-m-width, 343px), calc(100vw - 32px));
  min-height: var(--vp-np-m-height, 407px);
  margin-top: calc(var(--vp-np-m-offset-y, 0px) * -1);
}

@media screen and (min-width: 750px) {
  .popup-modal.vp-newsletter-popup .vp-newsletter-popup__content {
    width: min(var(--vp-np-d-width, 880px), calc(100vw - 80px));
    height: var(--vp-np-d-height, 440px);
    min-height: var(--vp-np-d-height, 440px);
    max-height: min(var(--vp-np-d-height, 440px), calc(100dvh - 80px));
    margin-top: 0;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "VP Newsletter popup",
  "tag": "section",
  "class": "section section-vp-newsletter-popup no-move",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Popup de newsletter a dos columnas. Reutiliza el comportamiento del Popup del tema (custom-popup)."
    },
    {
      "type": "header",
      "content": "Comportamiento"
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Modo",
      "options": [
        {
          "value": "enabled",
          "label": "Normal"
        },
        {
          "value": "test",
          "label": "Prueba"
        }
      ],
      "default": "enabled",
      "info": "El modo prueba muestra el popup aunque se haya cerrado antes."
    },
    {
      "type": "select",
      "id": "show_trigger",
      "label": "Mostrar al",
      "options": [
        {
          "value": "delay",
          "label": "Pasados unos segundos"
        },
        {
          "value": "exit_intent",
          "label": "Intentar salir (solo escritorio)"
        },
        {
          "value": "copy_to_clipboard",
          "label": "Copiar texto"
        },
        {
          "value": "click",
          "label": "Clic en un enlace"
        }
      ],
      "default": "delay"
    },
    {
      "type": "range",
      "id": "show_delay",
      "label": "Segundos de espera",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "s",
      "default": 4,
      "visible_if": "{{ section.settings.show_trigger == 'delay' }}"
    },
    {
      "type": "text",
      "id": "popup_id",
      "label": "ID del popup",
      "info": "Una sola palabra, sin espacios. Usa #ID en un enlace para abrirlo.",
      "visible_if": "{{ section.settings.show_trigger == 'click' }}"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibilidad",
      "options": [
        {
          "value": "both",
          "label": "Móvil y escritorio"
        },
        {
          "value": "mobile",
          "label": "Solo móvil"
        },
        {
          "value": "desktop",
          "label": "Solo escritorio"
        }
      ],
      "default": "both"
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Mostrar botón cerrar",
      "default": true
    },
    {
      "type": "header",
      "content": "Posición"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "label": "Posición en escritorio",
      "options": [
        {
          "value": "md:justify-start md:items-start",
          "label": "Arriba izquierda"
        },
        {
          "value": "md:justify-center md:items-start",
          "label": "Arriba centro"
        },
        {
          "value": "md:justify-end md:items-start",
          "label": "Arriba derecha"
        },
        {
          "value": "md:justify-start md:items-center",
          "label": "Medio izquierda"
        },
        {
          "value": "md:justify-center md:items-center",
          "label": "Medio centro"
        },
        {
          "value": "md:justify-end md:items-center",
          "label": "Medio derecha"
        },
        {
          "value": "md:justify-start md:items-end",
          "label": "Abajo izquierda"
        },
        {
          "value": "md:justify-center md:items-end",
          "label": "Abajo centro"
        },
        {
          "value": "md:justify-end md:items-end",
          "label": "Abajo derecha"
        }
      ],
      "default": "md:justify-center md:items-center"
    },
    {
      "type": "select",
      "id": "mobile_content_position",
      "label": "Posición en móvil",
      "options": [
        {
          "value": "justify-center items-start",
          "label": "Arriba"
        },
        {
          "value": "justify-center items-center",
          "label": "Medio"
        },
        {
          "value": "justify-center items-end",
          "label": "Abajo"
        }
      ],
      "default": "justify-center items-center"
    },
    {
      "type": "range",
      "id": "popup_offset_y_mobile",
      "label": "Desplazamiento vertical (móvil)",
      "min": -100,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "0 = centrado. Positivo sube el popup, negativo lo baja."
    },
    {
      "type": "header",
      "content": "Imagen"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen (escritorio)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagen móvil (opcional)",
      "info": "Si no se sube, se usa la imagen de escritorio."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posición de la imagen (escritorio)",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.image != blank }}"
    },
    {
      "type": "checkbox",
      "id": "hide_image_mobile",
      "label": "Ocultar imagen en móvil",
      "default": false,
      "visible_if": "{{ section.settings.image != blank }}"
    },
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Entérate primero de las mejores ofertas"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        {
          "value": "h3",
          "label": "S"
        },
        {
          "value": "h2",
          "label": "M"
        },
        {
          "value": "h1",
          "label": "L"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Únete a la comunidad de iClub y recibe novedades y beneficios exclusivos directo en tu correo.</p>"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Tamaño del texto",
      "options": [
        {
          "value": "caption",
          "label": "Caption"
        },
        {
          "value": "text-body",
          "label": "Body"
        },
        {
          "value": "subtitle",
          "label": "Subtitle"
        }
      ],
      "default": "text-body"
    },
    {
      "type": "text_alignment",
      "id": "content_alignment",
      "label": "Alineación del contenido",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Formulario"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Placeholder del email",
      "default": "Ingresa tu correo electrónico"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Suscribirme"
    },
    {
      "type": "text",
      "id": "customer_tags",
      "label": "Etiquetas de cliente",
      "default": "newsletter",
      "info": "Separadas por coma. Ejemplo: newsletter, iclub, popup."
    },
    {
      "type": "checkbox",
      "id": "show_success_in_popup",
      "label": "Mostrar mensaje de éxito en el popup",
      "default": true,
      "info": "Si está desactivado, el formulario se envía como antes (recarga o redirección)."
    },
    {
      "type": "inline_richtext",
      "id": "success_message",
      "label": "Mensaje de éxito",
      "default": "Gracias por escribirte",
      "info": "Se muestra dentro del popup al completar el formulario.",
      "visible_if": "{{ section.settings.show_success_in_popup }}"
    },
    {
      "type": "url",
      "id": "return_to",
      "label": "Página tras suscribirse",
      "info": "Opcional. Solo aplica si el mensaje de éxito en el popup está desactivado.",
      "visible_if": "{{ section.settings.show_success_in_popup == false }}"
    },
    {
      "type": "header",
      "content": "Privacidad"
    },
    {
      "type": "text",
      "id": "privacy_text",
      "label": "Texto de privacidad",
      "default": "Respetamos tu privacidad. Consulta nuestra"
    },
    {
      "type": "text",
      "id": "privacy_link_label",
      "label": "Texto del enlace",
      "default": "política de privacidad."
    },
    {
      "type": "url",
      "id": "privacy_link_url",
      "label": "URL del enlace",
      "visible_if": "{{ section.settings.privacy_link_label != blank }}"
    },
    {
      "type": "checkbox",
      "id": "privacy_link_new_tab",
      "label": "Abrir enlace en nueva pestaña",
      "default": true,
      "visible_if": "{{ section.settings.privacy_link_label != blank }}"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Fondo del panel",
      "default": "#1d1d1f"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Fondo del input",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Fondo del botón",
      "default": "#0071e3"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Texto del botón",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Color del enlace",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "close_color",
      "label": "Color del icono cerrar",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Radio del popup",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "input_radius",
      "label": "Radio del input",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Radio del botón",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "panel_padding_x",
      "label": "Espacio horizontal del panel",
      "min": 1,
      "max": 8,
      "step": 0.1,
      "unit": "rem",
      "default": 4,
      "info": "Padding izquierdo y derecho."
    },
    {
